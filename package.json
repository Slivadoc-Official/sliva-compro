{
  "name": "sliva-company-profile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/assets.mjs",
    "keywords": "node scripts/keywords.mjs",
    "build": "npm run typecheck && npm run assets && npm run keywords && vite build && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "playwright test",
    "test:seo": "node scripts/check-seo.mjs",
    "audit:performance": "node scripts/lighthouse.mjs",
    "format": "prettier --write src scripts tests *.ts *.json index.html README.md seo/SEO-STRATEGY.md",
    "format:check": "prettier --check src scripts tests *.ts *.json index.html README.md seo/SEO-STRATEGY.md"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^0.575.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
